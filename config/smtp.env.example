# Почта для жалоб (кнопка «!» в главном меню). Скопируйте в state/smtp.env (state/ не в git) и заполните.
# Сервер читает файл при каждой отправке — перезапуск не нужен.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, пароль — «пароль приложения» (Аккаунт Google → Безопасность → Пароли приложений).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ваш_адрес@gmail.com
SMTP_PASSWORD=пароль_приложения
SMTP_FROM=ваш_адрес@gmail.com
REPORT_TO=куда_приходят_жалобы@gmail.com
